diff --git a/ui/order-form.mjs b/ui/order-form.mjs
index 9232f59..64e4f08 100644
--- a/ui/order-form.mjs
+++ b/ui/order-form.mjs
@@ -1,3 +1,34 @@
 export async function submitOrder(fields, postJson) {
-  throw new Error("not implemented");
+  const itemName = typeof fields?.itemName === "string" ? fields.itemName.trim() : "";
+  const quantityText = typeof fields?.quantity === "string" ? fields.quantity.trim() : "";
+
+  if (!itemName) {
+    return { ok: false, error: "Product name is required", fields };
+  }
+  if (!/^[+-]?\d+$/.test(quantityText)) {
+    return { ok: false, error: "Quantity must be an integer between 1 and 20", fields };
+  }
+
+  const quantity = Number(quantityText);
+  if (!Number.isSafeInteger(quantity) || quantity < 1 || quantity > 20) {
+    return { ok: false, error: "Quantity must be an integer between 1 and 20", fields };
+  }
+
+  try {
+    const response = await postJson("/orders", { item_name: itemName, quantity });
+    if (response?.status === 201) {
+      return { ok: true, order: response.body };
+    }
+    return {
+      ok: false,
+      error: response?.body?.error ?? "Unable to create order",
+      fields,
+    };
+  } catch (error) {
+    return {
+      ok: false,
+      error: error instanceof Error ? error.message : "Unable to create order",
+      fields,
+    };
+  }
 }
diff --git a/ui/order-form.test.mjs b/ui/order-form.test.mjs
index 0f97de9..01bbbcb 100644
--- a/ui/order-form.test.mjs
+++ b/ui/order-form.test.mjs
@@ -18,3 +18,28 @@ test("keeps input when the server rejects the order", async () => {
   const result = await submitOrder(fields, async () => ({ status: 400, body: { error: "closed" } }));
   assert.deepEqual(result, { ok: false, error: "closed", fields });
 });
+
+test("rejects invalid fields locally without calling the API", async () => {
+  for (const fields of [
+    { itemName: "   ", quantity: "2" },
+    { itemName: "Pen", quantity: "2.5" },
+    { itemName: "Pen", quantity: "0" },
+    { itemName: "Pen", quantity: "21" },
+  ]) {
+    let called = false;
+    const result = await submitOrder(fields, async () => {
+      called = true;
+    });
+    assert.equal(result.ok, false);
+    assert.equal(result.fields, fields);
+    assert.equal(called, false);
+  }
+});
+
+test("keeps input when transport fails", async () => {
+  const fields = { itemName: "Pen", quantity: "2" };
+  const result = await submitOrder(fields, async () => {
+    throw new Error("offline");
+  });
+  assert.deepEqual(result, { ok: false, error: "offline", fields });
+});
