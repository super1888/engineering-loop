diff --git a/backend/orders.py b/backend/orders.py
index e9bf257..25a538e 100644
--- a/backend/orders.py
+++ b/backend/orders.py
@@ -1,2 +1,18 @@
 def create_order(store: list[dict], payload: dict) -> dict:
-    raise NotImplementedError
+    item_name = payload.get("item_name")
+    quantity = payload.get("quantity")
+
+    if not isinstance(item_name, str) or not item_name.strip():
+        raise ValueError("item_name must not be blank")
+    if isinstance(quantity, bool) or not isinstance(quantity, int):
+        raise ValueError("quantity must be an integer")
+    if not 1 <= quantity <= 20:
+        raise ValueError("quantity must be between 1 and 20")
+
+    order = {
+        "id": len(store) + 1,
+        "item_name": item_name.strip(),
+        "quantity": quantity,
+    }
+    store.append(order)
+    return order
diff --git a/ui/order-form.mjs b/ui/order-form.mjs
index 9232f59..3c68443 100644
--- a/ui/order-form.mjs
+++ b/ui/order-form.mjs
@@ -1,3 +1,36 @@
 export async function submitOrder(fields, postJson) {
-  throw new Error("not implemented");
+  const itemName = typeof fields.itemName === "string" ? fields.itemName.trim() : "";
+  const quantityText = typeof fields.quantity === "string" ? fields.quantity : "";
+  const quantity = Number(quantityText);
+
+  if (!itemName) {
+    return { ok: false, error: "Product name is required", fields };
+  }
+  if (!/^[-+]?\d+$/.test(quantityText.trim()) || !Number.isSafeInteger(quantity)) {
+    return { ok: false, error: "Quantity must be an integer", fields };
+  }
+  if (quantity < 1 || quantity > 20) {
+    return { ok: false, error: "Quantity must be between 1 and 20", fields };
+  }
+
+  try {
+    const response = await postJson("/orders", {
+      item_name: itemName,
+      quantity,
+    });
+    if (response.status === 201) {
+      return { ok: true, order: response.body };
+    }
+    return {
+      ok: false,
+      error: response.body?.error ?? "Order creation failed",
+      fields,
+    };
+  } catch (error) {
+    return {
+      ok: false,
+      error: error instanceof Error ? error.message : "Order creation failed",
+      fields,
+    };
+  }
 }
