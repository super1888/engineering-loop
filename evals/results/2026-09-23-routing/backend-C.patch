diff --git a/backend/orders.py b/backend/orders.py
index e9bf257..67bccc1 100644
--- a/backend/orders.py
+++ b/backend/orders.py
@@ -1,2 +1,30 @@
 def create_order(store: list[dict], payload: dict) -> dict:
-    raise NotImplementedError
+    """Validate, persist, and return a new order.
+
+    Validation is completed before the store is changed so rejected requests do
+    not consume an order ID.
+    """
+    if not isinstance(payload, dict):
+        raise ValueError("payload must be an object")
+
+    item_name = payload.get("item_name")
+    if not isinstance(item_name, str):
+        raise ValueError("item_name must be a string")
+
+    item_name = item_name.strip()
+    if not item_name:
+        raise ValueError("item_name must not be empty")
+
+    quantity = payload.get("quantity")
+    if isinstance(quantity, bool) or not isinstance(quantity, int):
+        raise ValueError("quantity must be an integer")
+    if not 1 <= quantity <= 20:
+        raise ValueError("quantity must be between 1 and 20")
+
+    order = {
+        "id": len(store) + 1,
+        "item_name": item_name,
+        "quantity": quantity,
+    }
+    store.append(order)
+    return order
