   assert.deepEqual(result, { ok: false, error: "closed", fields });
 });
+
+test("keeps input and does not call the API for invalid local fields", async () => {
+  const fields = { itemName: "Pen", quantity: "1.5" };
+  let called = false;
+  const result = await submitOrder(fields, async () => {
+    called = true;
+  });
+
+  assert.equal(called, false);
+  assert.deepEqual(result, { ok: false, error: "Quantity must be an integer", fields });
+});
