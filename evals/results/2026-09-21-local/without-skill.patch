+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+import sqlite3
+import tempfile
+import threading
+import unittest
+
+from inventory import Inventory
+
+
+class ReceiptRulesTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.path = Path(self.directory.name) / "stock.db"
+        self.inventory = Inventory(self.path)
+        self.addCleanup(lambda: self.inventory.close())
+        self.inventory.create_order("A", 100)
+        self.inventory.create_order("B", 100)
+
+    def snapshot(self):
+        return (
+            self.inventory.db.execute("SELECT * FROM orders ORDER BY order_id").fetchall(),
+            self.inventory.db.execute("SELECT * FROM receipts ORDER BY request_id").fetchall(),
+        )
+
+    def test_retry_returns_original_result_after_later_receipt_and_reopen(self):
+        self.assertEqual(self.inventory.receive("A", 60, "R1"), 60)
+        self.assertEqual(self.inventory.receive("A", 20, "R2"), 80)
+        before = self.snapshot()
+        self.inventory.close()
+        self.inventory = Inventory(self.path)
+        changes = self.inventory.db.total_changes
+        self.assertEqual(self.inventory.receive("A", 60, "R1"), 60)
+        self.assertEqual(self.inventory.db.total_changes, changes)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_request_identity_is_global_and_immutable(self):
+        self.inventory.receive("A", 60, "R1")
+        before = self.snapshot()
+        for order, quantity in [("A", 50), ("B", 60), ("unknown", 60)]:
+            with self.subTest(order=order, quantity=quantity):
+                with self.assertRaises(ValueError):
+                    self.inventory.receive(order, quantity, "R1")
+                self.assertEqual(self.snapshot(), before)
+
+    def test_invalid_quantities_do_not_write(self):
+        before = self.snapshot()
+        for quantity in [0, -1, 1.5, 1.0, "1", None, True, False]:
+            with self.subTest(quantity=quantity):
+                with self.assertRaises(ValueError):
+                    self.inventory.receive("A", quantity, "R1")
+                with self.assertRaises(ValueError):
+                    self.inventory.create_order("invalid", quantity)
+                self.assertEqual(self.snapshot(), before)
+        self.assertEqual(self.inventory.receive("A", 1, "R1"), 1)
+
+    def test_excess_rejection_does_not_consume_id(self):
+        self.inventory.receive("A", 60, "R1")
+        before = self.snapshot()
+        with self.assertRaises(ValueError):
+            self.inventory.receive("A", 50, "R3")
+        self.assertEqual(self.snapshot(), before)
+        self.assertEqual(self.inventory.receive("A", 40, "R3"), 100)
+        self.assertEqual(self.inventory.receive("A", 40, "R3"), 100)
+
+    def test_unknown_order_does_not_consume_id(self):
+        before = self.snapshot()
+        with self.assertRaises(KeyError):
+            self.inventory.receive("unknown", 1, "R1")
+        self.assertEqual(self.snapshot(), before)
+        self.assertEqual(self.inventory.receive("A", 1, "R1"), 1)
+
+    def test_receipt_insert_failure_rolls_back_inventory_and_allows_retry(self):
+        self.inventory.db.execute("""
+            CREATE TRIGGER reject_receipt BEFORE INSERT ON receipts
+            BEGIN SELECT RAISE(ABORT, 'injected receipt failure'); END
+        """)
+        before = self.snapshot()
+        with self.assertRaisesRegex(sqlite3.IntegrityError, "injected receipt failure"):
+            self.inventory.receive("A", 60, "R1")
+        self.assertEqual(self.snapshot(), before)
+        self.inventory.db.execute("DROP TRIGGER reject_receipt")
+        self.assertEqual(self.inventory.receive("A", 60, "R1"), 60)
+
+    def compete(self, requests):
+        ready = threading.Barrier(len(requests))
+
+        def receive(request):
+            inventory = Inventory(self.path)
+            try:
+                ready.wait(timeout=5)
+                try:
+                    return ("accepted", inventory.receive(*request))
+                except ValueError:
+                    return ("rejected", None)
+            finally:
+                inventory.close()
+
+        with ThreadPoolExecutor(max_workers=len(requests)) as executor:
+            return list(executor.map(receive, requests))
+
+    def test_competing_duplicate_receipts_record_once(self):
+        outcomes = self.compete([("A", 60, "R1"), ("A", 60, "R1")])
+        self.assertEqual(outcomes, [("accepted", 60), ("accepted", 60)])
+        self.assertEqual(self.inventory.received("A"), 60)
+        self.assertEqual(self.snapshot()[1], [("R1", "A", 60, 60)])
+
+    def test_competing_distinct_receipts_cannot_exceed_order(self):
+        outcomes = self.compete([("A", 60, "R1"), ("A", 60, "R2")])
+        self.assertCountEqual(outcomes, [("accepted", 60), ("rejected", None)])
+        receipts = self.snapshot()[1]
+        self.assertEqual(len(receipts), 1)
+        self.assertEqual(self.inventory.received("A"), 60)
+        rejected_id = "R2" if receipts[0][0] == "R1" else "R1"
+        self.assertEqual(self.inventory.receive("A", 40, rejected_id), 100)
+
+    def test_competing_reuse_across_orders_has_one_owner(self):
+        outcomes = self.compete([("A", 60, "R1"), ("B", 60, "R1")])
+        self.assertCountEqual(outcomes, [("accepted", 60), ("rejected", None)])
+        self.assertEqual(len(self.snapshot()[1]), 1)
+        self.assertEqual(self.inventory.received("A") + self.inventory.received("B"), 60)
+
+    def test_existing_order_and_receipt_rows_survive_open(self):
+        with self.inventory.db:
+            self.inventory.db.execute("UPDATE orders SET received = 80 WHERE order_id = 'A'")
+            self.inventory.db.executemany(
+                "INSERT INTO receipts VALUES (?, ?, ?, ?)",
+                [("old1", "A", 60, 60), ("old2", "A", 20, 80)],
+            )
+        before = self.snapshot()
+        self.inventory.close()
+        self.inventory = Inventory(self.path)
+        self.assertEqual(self.snapshot(), before)
+        self.assertEqual(self.inventory.receive("A", 60, "old1"), 60)
+        self.assertEqual(self.inventory.receive("A", 20, "new"), 100)
+
+
+if __name__ == "__main__":
+    unittest.main()
