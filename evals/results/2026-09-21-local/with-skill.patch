@@ -0,0 +1,127 @@
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+import sqlite3
+import tempfile
+import threading
+import unittest
+
+from inventory import Inventory
+
+
+class ReceiptRulesTests(unittest.TestCase):
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        self.path = Path(directory.name) / "stock.db"
+        self.inventory = Inventory(self.path)
+        self.addCleanup(self.inventory.close)
+        self.inventory.create_order("A", 100)
+        self.inventory.create_order("B", 100)
+
+    def snapshot(self):
+        return (
+            self.inventory.db.execute("SELECT * FROM orders ORDER BY order_id").fetchall(),
+            self.inventory.db.execute("SELECT * FROM receipts ORDER BY request_id").fetchall(),
+        )
+
+    def test_retry_returns_original_result_after_later_receipts_and_reopen(self):
+        self.assertEqual(self.inventory.receive("A", 60, "R1"), 60)
+        self.assertEqual(self.inventory.receive("A", 20, "R2"), 80)
+        expected = self.snapshot()
+        reopened = Inventory(self.path)
+        self.addCleanup(reopened.close)
+        self.assertEqual(reopened.receive("A", 60, "R1"), 60)
+        self.assertEqual(reopened.received("A"), 80)
+        self.assertEqual(self.snapshot(), expected)
+
+    def test_request_identity_is_global_and_immutable(self):
+        self.inventory.receive("A", 60, "R1")
+        expected = self.snapshot()
+        for order, quantity in [("A", 50), ("B", 60), ("missing", 60)]:
+            with self.subTest(order=order, quantity=quantity):
+                with self.assertRaises(ValueError):
+                    self.inventory.receive(order, quantity, "R1")
+                self.assertEqual(self.snapshot(), expected)
+
+    def test_invalid_quantities_do_not_write_or_consume_ids(self):
+        expected = self.snapshot()
+        for quantity in [0, -1, 1.5, "1", None, True, False]:
+            with self.subTest(quantity=quantity):
+                with self.assertRaises(ValueError):
+                    self.inventory.receive("A", quantity, "R1")
+                self.assertEqual(self.snapshot(), expected)
+        self.assertEqual(self.inventory.receive("A", 1, "R1"), 1)
+
+    def test_over_receipt_is_atomic_and_rejected_id_can_be_reused(self):
+        self.inventory.receive("A", 60, "R1")
+        expected = self.snapshot()
+        for quantity in [50, 10**100]:
+            with self.assertRaises(ValueError):
+                self.inventory.receive("A", quantity, "R3")
+            self.assertEqual(self.snapshot(), expected)
+        self.assertEqual(self.inventory.receive("A", 40, "R3"), 100)
+
+    def test_unknown_order_does_not_consume_request_id(self):
+        expected = self.snapshot()
+        with self.assertRaises(KeyError):
+            self.inventory.receive("missing", 1, "R1")
+        self.assertEqual(self.snapshot(), expected)
+        self.assertEqual(self.inventory.receive("A", 1, "R1"), 1)
+
+    def test_existing_data_and_original_results_survive_open(self):
+        with self.inventory.db:
+            self.inventory.db.execute("UPDATE orders SET received = 80 WHERE order_id = 'A'")
+            self.inventory.db.execute("INSERT INTO receipts VALUES ('old', 'A', 60, 60)")
+        expected = self.snapshot()
+        reopened = Inventory(self.path)
+        self.addCleanup(reopened.close)
+        self.assertEqual(reopened.receive("A", 60, "old"), 60)
+        self.assertEqual(self.snapshot(), expected)
+        self.assertEqual(reopened.receive("A", 20, "new"), 100)
+
+    def test_receipt_insert_failure_rolls_back_inventory_update(self):
+        self.inventory.db.executescript("""
+            CREATE TRIGGER fail_receipt BEFORE INSERT ON receipts
+            BEGIN SELECT RAISE(ABORT, 'injected receipt failure'); END;
+        """)
+        expected = self.snapshot()
+        with self.assertRaises(sqlite3.IntegrityError):
+            self.inventory.receive("A", 60, "R1")
+        self.assertEqual(self.snapshot(), expected)
+        self.inventory.db.execute("DROP TRIGGER fail_receipt")
+        self.assertEqual(self.inventory.receive("A", 60, "R1"), 60)
+
+    def race(self, requests):
+        barrier = threading.Barrier(len(requests))
+
+        def run(request):
+            inventory = Inventory(self.path)
+            try:
+                barrier.wait(timeout=5)
+                try:
+                    return ("accepted", inventory.receive(*request))
+                except ValueError:
+                    return ("rejected", None)
+            finally:
+                inventory.close()
+
+        with ThreadPoolExecutor(max_workers=len(requests)) as executor:
+            return list(executor.map(run, requests))
+
+    def test_concurrent_duplicate_requests_have_one_receipt(self):
+        self.assertEqual(self.race([("A", 60, "R1")] * 2),
+                         [("accepted", 60), ("accepted", 60)])
+        self.assertEqual(self.inventory.received("A"), 60)
+        self.assertEqual(self.snapshot()[1], [("R1", "A", 60, 60)])
+
+    def test_concurrent_distinct_receipts_cannot_exceed_order(self):
+        results = self.race([("A", 60, "R1"), ("A", 60, "R2")])
+        self.assertCountEqual(results, [("accepted", 60), ("rejected", None)])
+        self.assertEqual(self.inventory.received("A"), 60)
+        self.assertEqual(len(self.snapshot()[1]), 1)
+
+    def test_concurrent_conflicting_request_identity(self):
+        results = self.race([("A", 60, "R1"), ("B", 60, "R1")])
+        self.assertCountEqual(results, [("accepted", 60), ("rejected", None)])
+        self.assertEqual(self.inventory.received("A") + self.inventory.received("B"), 60)
+        self.assertEqual(len(self.snapshot()[1]), 1)
