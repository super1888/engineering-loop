+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+import tempfile
+import unittest
+
+from backend.service import ImportService
+
+
+class SubmissionTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.path = Path(self.directory.name) / 'service.db'
+        self.service = ImportService(self.path)
+
+    def test_submission_is_queued_and_durable(self):
+        rows = [{'rowId': 'opaque/001', 'name': 'Ada'}]
+        first = self.service.submit('client-operation', rows)
+        self.assertEqual(first['status'], 'QUEUED')
+        self.assertEqual(first['total'], 1)
+        self.assertEqual(first['succeeded'], 0)
+        self.assertEqual(self.service.records(), [])
+        reopened = ImportService(self.path)
+        self.assertEqual(reopened.submit('client-operation', rows)['batchId'], first['batchId'])
+        with self.assertRaisesRegex(ValueError, 'conflict'):
+            reopened.submit('client-operation', [{'rowId': 'opaque/001', 'name': 'Grace'}])
+        self.assertEqual(reopened.snapshot(first['batchId'])['status'], 'QUEUED')
+
+    def test_active_limit_is_100(self):
+        rows = [{'rowId': str(i), 'name': 'Name'} for i in range(100)]
+        self.assertEqual(self.service.submit('limit', rows)['total'], 100)
+        with self.assertRaises(ValueError):
+            self.service.submit('too-large', rows + [{'rowId': 'extra', 'name': 'Name'}])
+
+    def test_invalid_later_row_has_no_persisted_acceptance(self):
+        with self.assertRaises(ValueError):
+            self.service.submit('correctable', [{'rowId': 'ok', 'name': 'A'}, {'rowId': 'bad', 'name': ' '}])
+        self.assertEqual(self.service.submit('correctable', [{'rowId': 'ok', 'name': 'A'}])['total'], 1)
+
+    def test_missing_snapshot_is_key_error(self):
+        with self.assertRaises(KeyError):
+            self.service.snapshot('missing')
+
+    def test_concurrent_submission_has_one_durable_identity(self):
+        other = ImportService(self.path)
+        rows = [{'rowId': '01', 'name': 'A'}, {'rowId': '1', 'name': 'B'}]
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            futures = [pool.submit(service.submit, 'shared', rows) for service in (self.service, other)]
+            snapshots = [future.result() for future in futures]
+        self.assertEqual(snapshots[0]['batchId'], snapshots[1]['batchId'])
+        self.assertEqual([row['rowId'] for row in snapshots[0]['items']], ['01', '1'])
+    def test_partial_retry_preserves_success_and_replay_is_durable(self):
+        calls = []
+        def processor(row):
+            calls.append(row['rowId'])
+            if row['rowId'] == 'beta' and calls.count('beta') <= 2:
+                raise RuntimeError('transient beta failure')
+            return row['name'].upper()
+        self.service = ImportService(self.path, processor)
+        initial = self.service.submit('partial', [{'rowId': 'alpha', 'name': 'Ada'}, {'rowId': 'beta', 'name': 'Bob'}])
+        batch_id = initial['batchId']
+        self.assertEqual(initial['contractVersion'], 2)
+        self.assertEqual([item['attempts'] for item in initial['items']], [0, 0])
+        self.assertTrue(self.service.process_next())
+        partial = self.service.snapshot(batch_id)
+        self.assertEqual((partial['status'], partial['succeeded'], partial['failed']), ('PARTIAL', 1, 1))
+        saved_success = partial['items'][0]
+        saved_record = self.service.records()[0]
+        queued = self.service.retry(batch_id, 'retry-one')
+        self.assertEqual(queued['status'], 'QUEUED')
+        self.assertEqual(queued['items'][0], saved_success)
+        self.assertEqual(queued['items'][1], {'rowId': 'beta', 'status': 'QUEUED', 'attempts': 1, 'error': 'transient beta failure'})
+        self.service.process_next()
+        reopened = ImportService(self.path, processor)
+        replay = reopened.retry(batch_id, 'retry-one')
+        self.assertEqual(replay['status'], 'PARTIAL')
+        self.assertFalse(reopened.process_next())
+        reopened.retry(batch_id, 'retry-two')
+        reopened.process_next()
+        final = reopened.snapshot(batch_id)
+        self.assertEqual((final['status'], final['succeeded'], final['failed']), ('SUCCEEDED', 2, 0))
+        self.assertEqual(final['items'][0], saved_success)
+        self.assertEqual(final['items'][1], {'rowId': 'beta', 'status': 'SUCCEEDED', 'attempts': 3, 'error': None})
+        self.assertEqual(reopened.records()[0], saved_record)
+        self.assertEqual(len(reopened.records()), 2)
+        self.assertEqual(reopened.retry(batch_id, 'success-noop'), final)
+        self.assertFalse(reopened.process_next())
+        self.assertEqual(calls, ['alpha', 'beta', 'beta', 'beta'])
+
+    def test_two_workers_claim_only_one_batch_and_running_is_visible(self):
+        import threading
+        entered = threading.Event()
+        release = threading.Event()
+        calls = []
+        def processor(row):
+            calls.append(row['rowId'])
+            entered.set()
+            if not release.wait(5):
+                raise RuntimeError('test worker timed out')
+            return row['name']
+        worker = ImportService(self.path, processor)
+        other = ImportService(self.path, processor)
+        batch_id = worker.submit('worker-race', [{'rowId': 'opaque:/01', 'name': 'Ada'}])['batchId']
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            future = pool.submit(worker.process_next)
+            try:
+                self.assertTrue(entered.wait(5))
+                running = other.snapshot(batch_id)
+                self.assertEqual(running['status'], 'RUNNING')
+                self.assertEqual(running['items'][0]['attempts'], 1)
+                self.assertFalse(other.process_next())
+            finally:
+                release.set()
+            self.assertTrue(future.result(timeout=5))
+        self.assertEqual(calls, ['opaque:/01'])
+        self.assertEqual(len(worker.records()), 1)
+
+    def test_concurrent_retries_requeue_one_attempt(self):
+        calls = []
+        def processor(row):
+            calls.append(row['rowId'])
+            if len(calls) == 1:
+                raise RuntimeError('temporary')
+            return row['name']
+        worker = ImportService(self.path, processor)
+        other = ImportService(self.path, processor)
+        batch_id = worker.submit('race', [{'rowId': 'a', 'name': 'A'}])['batchId']
+        worker.process_next()
+        self.assertEqual(worker.snapshot(batch_id)['status'], 'FAILED')
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            futures = [pool.submit(service.retry, batch_id, 'same-retry') for service in (worker, other)]
+            for future in futures:
+                self.assertEqual(future.result()['status'], 'QUEUED')
+            futures = [pool.submit(service.process_next) for service in (worker, other)]
+            self.assertEqual(sorted(future.result() for future in futures), [False, True])
+        self.assertEqual(calls, ['a', 'a'])
+        self.assertEqual(worker.snapshot(batch_id)['items'][0]['attempts'], 2)
+        self.assertEqual(len(worker.records()), 1)
+
+    def test_retry_identity_is_batch_scoped_and_validated(self):
+        def fail(row):
+            raise RuntimeError('failed')
+        worker = ImportService(self.path, fail)
+        batches = [worker.submit(request, [{'rowId': 'same-row', 'name': 'A'}])['batchId'] for request in ('one', 'two')]
+        worker.process_next()
+        worker.process_next()
+        for batch_id in batches:
+            self.assertEqual(worker.retry(batch_id, 'same-retry')['status'], 'QUEUED')
+            with self.assertRaises(ValueError):
+                worker.retry(batch_id, ' ')
+        with self.assertRaises(KeyError):
+            worker.retry('missing', 'valid-request')
+
+    def test_retry_during_running_batch_waits_for_current_claim(self):
+        calls = []
+        worker = None
+        def processor(row):
+            calls.append(row['rowId'])
+            if row['rowId'] == 'a' and calls.count('a') == 1:
+                raise RuntimeError('first attempt')
+            if row['rowId'] == 'b':
+                receipt = worker.retry(batch_id, 'during-work')
+                self.assertEqual(receipt['status'], 'RUNNING')
+                self.assertEqual(receipt['items'][0]['error'], 'first attempt')
+                self.assertFalse(ImportService(self.path).process_next())
+            return row['name']
+        worker = ImportService(self.path, processor)
+        batch_id = worker.submit('during-work', [{'rowId': 'a', 'name': 'A'}, {'rowId': 'b', 'name': 'B'}])['batchId']
+        worker.process_next()
+        self.assertEqual(worker.snapshot(batch_id)['status'], 'QUEUED')
+        worker.process_next()
+        self.assertEqual(worker.snapshot(batch_id)['status'], 'SUCCEEDED')
+        self.assertEqual(calls, ['a', 'b', 'a'])
