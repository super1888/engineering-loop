+from contextlib import closing
+import json
+import uuid
+
+from .storage import connect, initialize
+
+
+class ImportService:
+    def __init__(self, db_path, processor=None):
+        self.db_path = str(db_path)
+        self.processor = processor or (lambda row: row['name'])
+        initialize(self.db_path)
+
+    def submit(self, request_id, rows):
+        if not isinstance(request_id, str) or not request_id.strip():
+            raise ValueError('requestId is required')
+        if not isinstance(rows, list) or not 1 <= len(rows) <= 100:
+            raise ValueError('rows must contain 1 to 100 entries')
+        identities = set()
+        for row in rows:
+            if not isinstance(row, dict) or not isinstance(row.get('rowId'), str) or not row['rowId'].strip():
+                raise ValueError('rowId is required')
+            if row['rowId'] in identities:
+                raise ValueError('rowId must be unique')
+            identities.add(row['rowId'])
+            if not isinstance(row.get('name'), str) or not row['name'].strip():
+                raise ValueError('name is required')
+        payload = json.dumps(rows, sort_keys=True, separators=(',', ':'), ensure_ascii=False)
+        with closing(connect(self.db_path)) as connection, connection:
+            connection.execute('BEGIN IMMEDIATE')
+            previous = connection.execute('SELECT id, payload FROM batches WHERE request_id = ?', (request_id,)).fetchone()
+            if previous:
+                if previous['payload'] != payload:
+                    raise ValueError('requestId conflict: payload differs')
+                batch_id = previous['id']
+            else:
+                batch_id = uuid.uuid4().hex
+                connection.execute('INSERT INTO batches (id, request_id, payload, status) VALUES (?, ?, ?, ?)',
+                                   (batch_id, request_id, payload, 'QUEUED'))
+                connection.executemany('INSERT INTO items (batch_id, row_id, name, status) VALUES (?, ?, ?, ?)',
+                                       [(batch_id, row['rowId'], row['name'], 'QUEUED') for row in rows])
+            return self._snapshot(connection, batch_id)
+
+    @staticmethod
+    def _snapshot(connection, batch_id):
+        batch = connection.execute('SELECT status FROM batches WHERE id = ?', (batch_id,)).fetchone()
+        if batch is None:
+            raise KeyError(batch_id)
+        rows = connection.execute('SELECT row_id, name, status, attempts, error FROM items WHERE batch_id = ? ORDER BY rowid',
+                                  (batch_id,)).fetchall()
+        return {'contractVersion': 2, 'batchId': batch_id, 'status': batch['status'], 'total': len(rows),
+                'succeeded': sum(row['status'] == 'SUCCEEDED' for row in rows),
+                'failed': sum(row['status'] == 'FAILED' for row in rows),
+                'items': [{'rowId': row['row_id'], 'status': row['status'],
+                          'attempts': row['attempts'], 'error': row['error']} for row in rows]}
+
+    def snapshot(self, batch_id):
+        with closing(connect(self.db_path)) as connection, connection:
+            connection.execute('BEGIN')
+            return self._snapshot(connection, batch_id)
+
+    def process_next(self):
+        # Claim the batch and its current work together. Processor calls happen
+        # outside the transaction so clients can observe RUNNING and outcomes.
+        with closing(connect(self.db_path)) as connection, connection:
+            connection.execute('BEGIN IMMEDIATE')
+            batch = connection.execute("SELECT id FROM batches WHERE status = 'QUEUED' ORDER BY rowid LIMIT 1").fetchone()
+            if batch is None:
+                return False
+            batch_id = batch['id']
+            rows = connection.execute("SELECT row_id, name FROM items WHERE batch_id = ? AND status = 'QUEUED' ORDER BY rowid",
+                                      (batch_id,)).fetchall()
+            connection.execute("UPDATE batches SET status = 'RUNNING' WHERE id = ?", (batch_id,))
+            connection.execute("UPDATE items SET status = 'RUNNING' WHERE batch_id = ? AND status = 'QUEUED'", (batch_id,))
+        for row in rows:
+            with closing(connect(self.db_path)) as connection, connection:
+                connection.execute('UPDATE items SET attempts = attempts + 1 WHERE batch_id = ? AND row_id = ?',
+                                   (batch_id, row['row_id']))
+            try:
+                output = self.processor({'rowId': row['row_id'], 'name': row['name']})
+            except Exception as error:
+                with closing(connect(self.db_path)) as connection, connection:
+                    connection.execute("UPDATE items SET status = 'FAILED', error = ? WHERE batch_id = ? AND row_id = ?",
+                                       (str(error) or type(error).__name__, batch_id, row['row_id']))
+            else:
+                with closing(connect(self.db_path)) as connection, connection:
+                    connection.execute('INSERT INTO records (batch_id, row_id, name) VALUES (?, ?, ?)',
+                                       (batch_id, row['row_id'], output))
+                    connection.execute("UPDATE items SET status = 'SUCCEEDED', error = NULL, output = ? WHERE batch_id = ? AND row_id = ?",
+                                       (output, batch_id, row['row_id']))
+        with closing(connect(self.db_path)) as connection, connection:
+            connection.execute('BEGIN IMMEDIATE')
+            states = {row['status'] for row in connection.execute('SELECT status FROM items WHERE batch_id = ?', (batch_id,))}
+            if 'QUEUED' in states:
+                status = 'QUEUED'
+            elif states == {'SUCCEEDED'}:
+                status = 'SUCCEEDED'
+            elif states == {'FAILED'}:
+                status = 'FAILED'
+            else:
+                status = 'PARTIAL'
+            connection.execute('UPDATE batches SET status = ? WHERE id = ?', (status, batch_id))
+        return True
+
+    def retry(self, batch_id, request_id):
+        if not isinstance(request_id, str) or not request_id.strip():
+            raise ValueError('requestId is required')
+        with closing(connect(self.db_path)) as connection, connection:
+            connection.execute('BEGIN IMMEDIATE')
+            snapshot = self._snapshot(connection, batch_id)
+            previous = connection.execute('SELECT 1 FROM retry_requests WHERE batch_id = ? AND request_id = ?',
+                                          (batch_id, request_id)).fetchone()
+            if not previous:
+                connection.execute('INSERT INTO retry_requests (batch_id, request_id) VALUES (?, ?)', (batch_id, request_id))
+                changed = connection.execute("UPDATE items SET status = 'QUEUED' WHERE batch_id = ? AND status = 'FAILED'",
+                                             (batch_id,)).rowcount
+                if changed and snapshot['status'] != 'RUNNING':
+                    connection.execute("UPDATE batches SET status = 'QUEUED' WHERE id = ?", (batch_id,))
+            return self._snapshot(connection, batch_id)
+
+    def records(self):
+        with closing(connect(self.db_path)) as connection:
+            return [dict(row) for row in connection.execute(
+                'SELECT batch_id AS batchId, row_id AS rowId, name FROM records ORDER BY rowid')]
