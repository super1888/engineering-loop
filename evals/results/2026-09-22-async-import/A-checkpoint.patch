new file mode 100644
index 0000000..3724f88
--- /dev/null
+++ b/tests/test_service.py
@@ -0,0 +1,52 @@
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+import tempfile
+import unittest
+
+from backend.service import ImportService
+
+
+class ServiceTests(unittest.TestCase):
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        self.path = Path(directory.name) / 'test.db'
+        self.service = ImportService(self.path)
+        self.rows = [{'rowId': '001', 'name': 'Ada'}, {'rowId': 'alpha / 中文', 'name': 'Lin'}]
+
+    def test_submission_is_queued_and_preserves_opaque_identities(self):
+        snapshot = self.service.submit('request', self.rows)
+        self.assertEqual(snapshot['status'], 'QUEUED')
+        self.assertEqual((snapshot['total'], snapshot['succeeded'], snapshot['failed']), (2, 0, 0))
+        self.assertEqual(snapshot['rows'], [dict(row, status='QUEUED', attempts=0, error=None) for row in self.rows])
+        self.assertEqual(self.service.records(), [])
+        self.assertEqual(self.service.snapshot(snapshot['batchId']), snapshot)
+
+    def test_submission_identity_survives_reopen_and_object_key_order(self):
+        original = self.service.submit('request', self.rows)
+        reopened = ImportService(self.path)
+        reordered = [{'name': row['name'], 'rowId': row['rowId']} for row in self.rows]
+        self.assertEqual(reopened.submit('request', reordered), original)
+        with self.assertRaisesRegex(ValueError, 'conflict'):
+            reopened.submit('request', list(reversed(self.rows)))
+        self.assertEqual(reopened.snapshot(original['batchId']), original)
+
+    def test_limit_is_100_and_rejection_does_not_consume_identity(self):
+        rows = [{'rowId': str(index), 'name': 'Name'} for index in range(101)]
+        with self.assertRaises(ValueError):
+            self.service.submit('request', rows)
+        self.assertEqual(self.service.submit('request', rows[:100])['total'], 100)
+
+    def test_missing_snapshot(self):
+        with self.assertRaises(KeyError):
+            self.service.snapshot('missing')
+
+    def test_simultaneous_identical_submissions_create_one_batch(self):
+        other = ImportService(self.path)
+        with ThreadPoolExecutor(max_workers=2) as workers:
+            snapshots = list(workers.map(lambda service: service.submit('request', self.rows), [self.service, other]))
+        self.assertEqual(snapshots[0], snapshots[1])
+
+
+if __name__ == '__main__':
+    unittest.main()
