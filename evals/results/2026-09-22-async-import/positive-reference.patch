+from .storage import initialize, connect
+from contextlib import closing
+import json
+import uuid
+
+
+class ImportService:
+    def __init__(self, db_path, processor=None):
+        self.db_path = str(db_path)
+        self.processor = processor or (lambda row: row['name'])
+        initialize(self.db_path)
+
+    def submit(self, request_id, rows):
+        if not isinstance(request_id, str) or not request_id.strip():
+            raise ValueError('requestId is required')
+        if not isinstance(rows, list) or not 1 <= len(rows) <= 100:
+            raise ValueError('rows must contain 1 to 100 entries')
+        identities = set()
+        for row in rows:
+            if not isinstance(row, dict) or not isinstance(row.get('rowId'), str) or not row['rowId'].strip():
+                raise ValueError('rowId is required')
+            if row['rowId'] in identities:
+                raise ValueError('rowId must be unique')
+            identities.add(row['rowId'])
+            if not isinstance(row.get('name'), str) or not row['name'].strip():
+                raise ValueError('name is required')
+
+        payload = json.dumps(rows, sort_keys=True)
+        with closing(connect(self.db_path)) as c, c:
+            c.execute('BEGIN IMMEDIATE')
+            old = c.execute('SELECT * FROM batches WHERE request_id=?', (request_id,)).fetchone()
+            if old:
+                if old['payload'] != payload:
+                    raise ValueError('payload conflict')
+                bid = old['id']
+            else:
+                bid = str(uuid.uuid4())
+                c.execute('INSERT INTO batches VALUES (?,?,?,?)', (bid,request_id,payload,'QUEUED'))
+                c.executemany('INSERT INTO items(batch_id,row_id,name,status) VALUES (?,?,?,?)',
+                    [(bid,r['rowId'],r['name'],'QUEUED') for r in rows])
+        return self.snapshot(bid)
+
+    def snapshot(self, batch_id):
+        with closing(connect(self.db_path)) as c, c:
+            c.execute('BEGIN')
+            b = c.execute('SELECT * FROM batches WHERE id=?',(batch_id,)).fetchone()
+            if not b: raise KeyError(batch_id)
+            rows = c.execute('SELECT * FROM items WHERE batch_id=?',(batch_id,)).fetchall()
+            return dict(contractVersion=2,batchId=batch_id,status=b['status'],total=len(rows),
+                succeeded=sum(r['status']=='SUCCEEDED' for r in rows),failed=sum(r['status']=='FAILED' for r in rows),
+                items=[dict(rowId=r['row_id'],status=r['status'],attempts=r['attempts'],error=r['error']) for r in rows])
+
+    def process_next(self):
+        with closing(connect(self.db_path)) as c, c:
+            c.execute('BEGIN IMMEDIATE')
+            b = c.execute("SELECT * FROM batches WHERE status='QUEUED' LIMIT 1").fetchone()
+            if not b: return False
+            bid=b['id']
+            c.execute("UPDATE batches SET status='RUNNING' WHERE id=?",(bid,))
+            rows=c.execute("SELECT * FROM items WHERE batch_id=? AND status='QUEUED'",(bid,)).fetchall()
+        for row in rows:
+            with closing(connect(self.db_path)) as c, c:
+                c.execute("UPDATE items SET status='RUNNING', attempts=attempts+1 WHERE batch_id=? AND row_id=?",(bid,row['row_id']))
+            try:
+                value=self.processor(dict(rowId=row['row_id'],name=row['name']))
+            except RuntimeError as error:
+                with closing(connect(self.db_path)) as c, c:
+                    c.execute("UPDATE items SET status='FAILED',error=? WHERE batch_id=? AND row_id=?",(str(error),bid,row['row_id']))
+            else:
+                with closing(connect(self.db_path)) as c, c:
+                    c.execute("UPDATE items SET status='SUCCEEDED',error=NULL,output=? WHERE batch_id=? AND row_id=?",(value,bid,row['row_id']))
+                    c.execute('INSERT INTO records VALUES (?,?,?)',(bid,row['row_id'],value))
+        with closing(connect(self.db_path)) as c, c:
+            c.execute('BEGIN IMMEDIATE')
+            states=[r[0] for r in c.execute('SELECT status FROM items WHERE batch_id=?',(bid,))]
+            state='QUEUED' if 'QUEUED' in states else 'PARTIAL' if 'FAILED' in states and 'SUCCEEDED' in states else 'FAILED' if 'FAILED' in states else 'SUCCEEDED'
+            c.execute('UPDATE batches SET status=? WHERE id=?',(state,bid))
+        return True
+
+    def retry(self, batch_id, request_id):
+        if not isinstance(request_id,str) or not request_id.strip(): raise ValueError('requestId required')
+        with closing(connect(self.db_path)) as c, c:
+            c.execute('BEGIN IMMEDIATE')
+            b=c.execute('SELECT * FROM batches WHERE id=?',(batch_id,)).fetchone()
+            if not b: raise KeyError(batch_id)
+            seen=c.execute('SELECT * FROM retry_requests WHERE batch_id=? AND request_id=?',(batch_id,request_id)).fetchone()
+            if not seen:
+                c.execute('INSERT INTO retry_requests VALUES (?,?)',(batch_id,request_id))
+                changed=c.execute("UPDATE items SET status='QUEUED' WHERE batch_id=? AND status='FAILED'",(batch_id,)).rowcount
+                if changed and b['status']!='RUNNING': c.execute("UPDATE batches SET status='QUEUED' WHERE id=?",(batch_id,))
+        return self.snapshot(batch_id)
+
+    def records(self):
+        with closing(connect(self.db_path)) as c:
+            return [dict(batchId=r['batch_id'],rowId=r['row_id'],name=r['name']) for r in c.execute('SELECT * FROM records')]
