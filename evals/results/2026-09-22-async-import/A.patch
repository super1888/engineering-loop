+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+import tempfile
+import threading
+import unittest
+
+from backend.service import ImportService
+
+
+class ServiceTests(unittest.TestCase):
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        self.path = Path(directory.name) / 'test.db'
+        self.service = ImportService(self.path)
+        self.rows = [{'rowId': '001', 'name': 'Ada'}, {'rowId': 'alpha / 中文', 'name': 'Lin'}]
+
+    def test_submission_is_queued_and_preserves_opaque_identities(self):
+        snapshot = self.service.submit('request', self.rows)
+        self.assertEqual(snapshot['status'], 'QUEUED')
+        self.assertEqual(snapshot['contractVersion'], 2)
+        self.assertEqual((snapshot['total'], snapshot['succeeded'], snapshot['failed']), (2, 0, 0))
+        self.assertEqual(snapshot['items'], [dict(rowId=row['rowId'], status='QUEUED', attempts=0, error=None) for row in self.rows])
+        self.assertEqual(self.service.records(), [])
+        self.assertEqual(self.service.snapshot(snapshot['batchId']), snapshot)
+
+    def test_submission_identity_survives_reopen_and_object_key_order(self):
+        original = self.service.submit('request', self.rows)
+        reopened = ImportService(self.path)
+        reordered = [{'name': row['name'], 'rowId': row['rowId']} for row in self.rows]
+        self.assertEqual(reopened.submit('request', reordered), original)
+        with self.assertRaisesRegex(ValueError, 'conflict'):
+            reopened.submit('request', list(reversed(self.rows)))
+        self.assertEqual(reopened.snapshot(original['batchId']), original)
+
+    def test_limit_is_100_and_rejection_does_not_consume_identity(self):
+        rows = [{'rowId': str(index), 'name': 'Name'} for index in range(101)]
+        with self.assertRaises(ValueError):
+            self.service.submit('request', rows)
+        self.assertEqual(self.service.submit('request', rows[:100])['total'], 100)
+
+    def test_missing_snapshot(self):
+        with self.assertRaises(KeyError):
+            self.service.snapshot('missing')
+
+    def test_simultaneous_identical_submissions_create_one_batch(self):
+        other = ImportService(self.path)
+        with ThreadPoolExecutor(max_workers=2) as workers:
+            snapshots = list(workers.map(lambda service: service.submit('request', self.rows), [self.service, other]))
+        self.assertEqual(snapshots[0], snapshots[1])
+
+    def test_partial_outcome_failed_only_retry_and_durable_replay(self):
+        calls = []
+
+        def processor(row):
+            calls.append(row['rowId'])
+            if row['rowId'] == 'alpha / 中文' and calls.count(row['rowId']) <= 2:
+                raise RuntimeError('temporary failure')
+            return row['name'].upper()
+
+        self.service = ImportService(self.path, processor)
+        batch_id = self.service.submit('request', self.rows)['batchId']
+        self.assertTrue(self.service.process_next())
+        partial = self.service.snapshot(batch_id)
+        self.assertEqual((partial['status'], partial['succeeded'], partial['failed']), ('PARTIAL', 1, 1))
+        self.assertEqual([item['attempts'] for item in partial['items']], [1, 1])
+        saved_success = partial['items'][0]
+        successful_record = self.service.records()[0]
+        queued = self.service.retry(batch_id, 'retry-1')
+        self.assertEqual(queued['status'], 'QUEUED')
+        self.assertEqual(queued['items'][1], dict(rowId='alpha / 中文', status='QUEUED', attempts=1, error='temporary failure'))
+        self.assertEqual(self.service.retry(batch_id, 'retry-1'), queued)
+        self.assertTrue(self.service.process_next())
+        failed_again = self.service.snapshot(batch_id)
+        reopened = ImportService(self.path, processor)
+        self.assertEqual(reopened.retry(batch_id, 'retry-1'), failed_again)
+        self.assertFalse(reopened.process_next())
+        self.assertEqual(reopened.retry(batch_id, 'retry-2')['status'], 'QUEUED')
+        self.assertTrue(reopened.process_next())
+        completed = reopened.snapshot(batch_id)
+        self.assertEqual((completed['status'], completed['succeeded'], completed['failed']), ('SUCCEEDED', 2, 0))
+        self.assertEqual(completed['items'][0], saved_success)
+        self.assertEqual(completed['items'][1]['attempts'], 3)
+        self.assertIsNone(completed['items'][1]['error'])
+        self.assertEqual(reopened.records()[0], successful_record)
+        self.assertEqual(len(reopened.records()), 2)
+        self.assertEqual(calls, ['001', 'alpha / 中文', 'alpha / 中文', 'alpha / 中文'])
+        self.assertEqual(reopened.retry(batch_id, 'no-op'), completed)
+        self.assertFalse(reopened.process_next())
+
+    def test_all_failure_and_success_terminal_statuses(self):
