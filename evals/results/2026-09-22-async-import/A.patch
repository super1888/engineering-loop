+                self.assertTrue(entered.wait(5))
+                running = self.service.snapshot(batch_id)
+                self.assertEqual(running['status'], 'RUNNING')
+                self.assertEqual(running['items'][0]['status'], 'RUNNING')
+                self.assertEqual(running['items'][0]['attempts'], 1)
+                self.assertFalse(self.service.process_next())
+            finally:
+                release.set()
+            self.assertTrue(first.result(timeout=5))
+        self.assertEqual(calls, [row['rowId'] for row in self.rows])
+        self.assertEqual(len(self.service.records()), 2)
+
+    def test_simultaneous_retry_replay_queues_one_attempt(self):
+        def failure(row):
+            raise RuntimeError('failure')
+
+        worker = ImportService(self.path, failure)
+        batch_id = worker.submit('request', self.rows)['batchId']
+        worker.process_next()
+        other = ImportService(self.path)
+        with ThreadPoolExecutor(max_workers=2) as workers:
+            snapshots = list(workers.map(lambda service: service.retry(batch_id, 'retry'), [self.service, other]))
+        self.assertEqual(snapshots[0], snapshots[1])
+        self.service.process_next()
+        self.assertEqual([item['attempts'] for item in self.service.snapshot(batch_id)['items']], [2, 2])
+        self.assertEqual(len(self.service.records()), 2)
+
+    def test_retry_identity_is_batch_scoped_and_input_validated(self):
+        def failure(row):
+            raise RuntimeError('failure')
+
+        worker = ImportService(self.path, failure)
+        ids = [worker.submit(request, self.rows)['batchId'] for request in ('first', 'second')]
+        worker.process_next()
+        worker.process_next()
+        for batch_id in ids:
+            with self.assertRaises(ValueError):
+                worker.retry(batch_id, ' ')
+            self.assertEqual(worker.retry(batch_id, 'same-retry')['status'], 'QUEUED')
+        with self.assertRaises(KeyError):
+            worker.retry('missing', 'valid')
+
+    def test_retry_during_processing_drains_failures_and_preserves_error(self):
+        second_entered = threading.Event()
+        second_release = threading.Event()
+        retry_entered = threading.Event()
+        retry_release = threading.Event()
+        calls = []
+
+        def processor(row):
+            calls.append(row['rowId'])
+            if row['rowId'] == '001':
+                if calls.count('001') == 1:
+                    raise RuntimeError('original error')
+                retry_entered.set()
+                if not retry_release.wait(5):
+                    raise RuntimeError('retry test timed out')
+            else:
+                second_entered.set()
+                if not second_release.wait(5):
+                    raise RuntimeError('second test timed out')
+            return row['name']
+
+        worker = ImportService(self.path, processor)
+        batch_id = worker.submit('request', self.rows)['batchId']
+        with ThreadPoolExecutor(max_workers=1) as workers:
+            work = workers.submit(worker.process_next)
+            try:
+                self.assertTrue(second_entered.wait(5))
+                queued = self.service.retry(batch_id, 'during-work')
+                self.assertEqual(queued['status'], 'RUNNING')
+                self.assertEqual(queued['items'][0], dict(rowId='001', status='QUEUED', attempts=1, error='original error'))
+                self.assertFalse(self.service.process_next())
+                second_release.set()
+                self.assertTrue(retry_entered.wait(5))
+                running = self.service.snapshot(batch_id)
+                self.assertEqual(running['items'][0], dict(rowId='001', status='RUNNING', attempts=2, error='original error'))
+            finally:
+                second_release.set()
+                retry_release.set()
+            self.assertTrue(work.result(timeout=5))
+        done = self.service.snapshot(batch_id)
+        self.assertEqual(done['status'], 'SUCCEEDED')
+        self.assertIsNone(done['items'][0]['error'])
+        self.assertEqual(calls, ['001', 'alpha / 中文', '001'])
+        self.assertEqual(len(self.service.records()), 2)
+
+    def test_retry_without_current_failures_is_a_durable_noop(self):
+        def failure(row):
+            raise RuntimeError('failure')
+
+        worker = ImportService(self.path, failure)
+        queued = worker.submit('request', self.rows)
+        self.assertEqual(worker.retry(queued['batchId'], 'early-retry'), queued)
+        worker.process_next()
+        failed = worker.snapshot(queued['batchId'])
+        reopened = ImportService(self.path)
+        self.assertEqual(reopened.retry(queued['batchId'], 'early-retry'), failed)
+        self.assertFalse(reopened.process_next())
+
+
+if __name__ == '__main__':
+    unittest.main()
