+    def test_workers_claim_once_and_running_is_observable(self):
+        entered = threading.Event()
+        release = threading.Event()
+        calls = []
+
+        def processor(row):
+            calls.append(row['rowId'])
+            entered.set()
+            if not release.wait(5):
