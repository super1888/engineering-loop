diff --git a/tests/test_service.py b/tests/test_service.py
new file mode 100644
index 0000000..78d8560
--- /dev/null
+++ b/tests/test_service.py
@@ -0,0 +1,41 @@
+from pathlib import Path
+import tempfile
+import unittest
+
+from backend.service import ImportService
+
+
+class SubmissionTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.path = Path(self.directory.name) / 'service.db'
+        self.service = ImportService(self.path)
+
+    def test_submission_is_queued_and_durable(self):
+        rows = [{'rowId': 'opaque/001', 'name': 'Ada'}]
+        first = self.service.submit('client-operation', rows)
+        self.assertEqual(first['status'], 'QUEUED')
+        self.assertEqual(first['total'], 1)
+        self.assertEqual(first['succeeded'], 0)
+        self.assertEqual(self.service.records(), [])
+        reopened = ImportService(self.path)
+        self.assertEqual(reopened.submit('client-operation', rows)['batchId'], first['batchId'])
+        with self.assertRaisesRegex(ValueError, 'conflict'):
+            reopened.submit('client-operation', [{'rowId': 'opaque/001', 'name': 'Grace'}])
+        self.assertEqual(reopened.snapshot(first['batchId'])['status'], 'QUEUED')
+
+    def test_active_limit_is_100(self):
+        rows = [{'rowId': str(i), 'name': 'Name'} for i in range(100)]
+        self.assertEqual(self.service.submit('limit', rows)['total'], 100)
+        with self.assertRaises(ValueError):
+            self.service.submit('too-large', rows + [{'rowId': 'extra', 'name': 'Name'}])
+
+    def test_invalid_later_row_has_no_persisted_acceptance(self):
+        with self.assertRaises(ValueError):
+            self.service.submit('correctable', [{'rowId': 'ok', 'name': 'A'}, {'rowId': 'bad', 'name': ' '}])
+        self.assertEqual(self.service.submit('correctable', [{'rowId': 'ok', 'name': 'A'}])['total'], 1)
+
+    def test_missing_snapshot_is_key_error(self):
+        with self.assertRaises(KeyError):
+            self.service.snapshot('missing')
