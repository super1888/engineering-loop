* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
# Keep evaluation fixtures/evidence stable; unified-diff blank context carries a space.
evals/fixtures/**/*.html text eol=lf
evals/fixtures/**/*.js text eol=lf
evals/**/*.cjs text eol=lf
evals/results/** text eol=lf
evals/results/**/*.patch whitespace=-blank-at-eol
# Preserve mixed source line endings embedded in this trial's replay patches.
evals/results/2026-09-22-async-import/*.patch -text whitespace=-blank-at-eol,cr-at-eol
